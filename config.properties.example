# Copy this file to config.properties and fill in the values for YOUR machine.
# config.properties is gitignored and should never be committed.

# Absolute path to the APK generated by the Flutter build.
# Generate with: flutter build apk --debug --dart-define=API_URL=http://10.0.2.2:8000
# Then run: realpath build/app/outputs/flutter-apk/app-debug.apk
app.path=

# Device/emulator name, as shown by "adb devices"
device.name=

# Appium Server URL
appium.server.url=

# Passenger account (can_drive = false) — used for search/request ride flows
test.passenger.email=your-passenger-test-account@allowed-domain.com
test.passenger.password=your-test-password

# Driver account (can_drive = true) — used for offer/accept/complete ride flows
test.driver.email=your-driver-test-account@allowed-domain.com
test.driver.password=your-test-password
